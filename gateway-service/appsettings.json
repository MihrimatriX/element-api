{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000" ]
  },
  "RedisConnection": "localhost:6379",
  "IdentityServiceInternalUrl": "http://localhost:5001",
  "ElementServiceInternalUrl": "http://localhost:5002",
  "ReverseProxy": {
    "Routes": {
      "api-info-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**remainder}"
        }
      },
      "api-keys-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/api-keys/{**remainder}"
        }
      },
      "element-history-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/elements/{symbol}/history"
        },
        "Metadata": {
          "RequireApiKey": "true"
        }
      },
      "element-write-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/elements/{**remainder}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        },
        "Metadata": {
          "RequireApiKey": "true"
        }
      },
      "element-read-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/elements/{**remainder}",
          "Methods": [ "GET" ]
        }
      },
      "categories-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/categories/{**remainder}"
        }
      },
      "statistics-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/statistics/{**remainder}"
        }
      },
      "statistics-root-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/statistics"
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/v1/orders/{**remainder}"
        },
        "Metadata": {
          "RequireApiKey": "true"
        }
      },
      "api-keys-list-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/api-keys"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/hub/notifications/{**remainder}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "element-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5006"
          }
        }
      }
    }
  }
}
