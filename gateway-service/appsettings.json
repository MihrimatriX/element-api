{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173" ]
  },
  "RedisConnection": "localhost:6379",
  "IdentityServiceInternalUrl": "http://localhost:5001",
  "ElementServiceInternalUrl": "http://localhost:5002",
  "INTERNAL_API_KEY": "element-internal-dev-key",
  "ReverseProxy": {
    "Routes": {
      "api-info-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1"
        }
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**remainder}"
        }
      },
      "api-keys-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/api-keys/{**remainder}"
        }
      },
      "api-keys-list-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/api-keys"
        }
      },
      "webhooks-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/webhooks/{**remainder}"
        }
      },
      "webhooks-root-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/webhooks"
        }
      },
      "element-history-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/elements/{symbol}/history"
        },
        "Metadata": {
          "RequireApiKey": "true"
        }
      },
      "element-ticker-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/elements/{symbol}/ticker",
          "Methods": [ "GET" ]
        }
      },
      "element-write-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/elements/{**remainder}",
          "Methods": [ "POST", "PUT", "DELETE" ]
        },
        "Metadata": {
          "RequireApiKey": "true"
        }
      },
      "element-read-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/elements/{**remainder}",
          "Methods": [ "GET" ]
        }
      },
      "scientific-elements-route": {
        "ClusterId": "element-cluster",
        "Match": { "Path": "/api/v2/elements/{**remainder}", "Methods": [ "GET", "OPTIONS" ] },
        "CorsPolicy": "PublicScience"
      },
      "scientific-compounds-route": {
        "ClusterId": "compound-cluster",
        "Match": { "Path": "/api/v2/compounds/{**remainder}", "Methods": [ "GET", "OPTIONS" ] },
        "CorsPolicy": "PublicScience"
      },
      "categories-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/categories/{**remainder}"
        }
      },
      "statistics-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/statistics/{**remainder}"
        }
      },
      "statistics-root-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/statistics"
        }
      },
      "market-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/api/v1/market/{**remainder}"
        }
      },
      "compounds-root-route": {
        "ClusterId": "compound-cluster",
        "Match": {
          "Path": "/api/v1/compounds",
          "Methods": [ "GET" ]
        }
      },
      "compounds-route": {
        "ClusterId": "compound-cluster",
        "Match": {
          "Path": "/api/v1/compounds/{**remainder}",
          "Methods": [ "GET" ]
        }
      },
      "element-compounds-route": {
        "ClusterId": "compound-cluster",
        "Order": -1,
        "Match": {
          "Path": "/api/v1/elements/{symbol}/compounds",
          "Methods": [ "GET" ]
        }
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/v1/orders/{**remainder}"
        },
        "Metadata": {
          "RequireApiKey": "true"
        }
      },
      "me-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/v1/me/{**remainder}"
        },
        "Metadata": {
          "RequireApiKey": "true"
        }
      },
      "desk-route": {
        "ClusterId": "order-cluster",
        "Match": {
          "Path": "/api/v1/desk/{**remainder}"
        },
        "Metadata": {
          "RequireApiKey": "true"
        }
      },
      "shipment-track-route": {
        "ClusterId": "shipment-cluster",
        "Match": {
          "Path": "/api/v1/shipments/track/{**remainder}"
        },
        "Metadata": {
          "RequireApiKey": "true"
        }
      },
      "swagger-root-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/swagger"
        }
      },
      "swagger-route": {
        "ClusterId": "element-cluster",
        "Match": {
          "Path": "/swagger/{**remainder}"
        }
      },
      "notification-route": {
        "ClusterId": "notification-cluster",
        "Match": {
          "Path": "/hub/notifications/{**remainder}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "element-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "order-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5006"
          }
        }
      },
      "shipment-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "compound-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5007"
          }
        }
      }
    }
  }
}
