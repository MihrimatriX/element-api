{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Jaeger", "url": "http://localhost:16686", "type": "link" },
    { "title": "Seq", "url": "http://localhost:5341", "type": "link" },
    { "title": "Gateway Health UI", "url": "http://localhost:5000/health-ui", "type": "link" }
  ],
  "panels": [
    {
      "title": "Servis UP",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=~\"gateway-service|identity-service|catalog-service|order-service|shipment-service|notification-service|payment-service\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "HTTP istek hızı (ASP.NET)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "HTTP p95 gecikme (ASP.NET)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_request_duration_seconds_bucket[5m])) by (le, service))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Order service — istek/s",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "legendFormat": "order-service"
        }
      ]
    },
    {
      "title": "Container logları (Loki)",
      "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "{service=~\"gateway-service|identity-service|catalog-service|order-service|shipment-service|notification-service|payment-service\"}",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["element-market", "observability"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "Element Market — Overview",
  "uid": "element-market-overview",
  "version": 1
}
