# Kök docker compose için: copy docker/.env.example docker/.env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
JWT_SECRET=ChangeMeInProduction_UseLongRandomSecretKey123!
RABBITMQ_DEFAULT_USER=element
RABBITMQ_DEFAULT_PASS=element_dev_rabbit_secret

# Observability
SEQ_URL=http://seq:80
OTLP_ENDPOINT=http://jaeger:4317
OTLP_HTTP_ENDPOINT=http://jaeger:4318/v1/traces
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ELK / Logstash
LOGSTASH_HTTP_URL=http://logstash:8080
LOGSTASH_TCP_HOST=logstash
LOGSTASH_TCP_PORT=50000
