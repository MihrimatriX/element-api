# LOCAL full platform only. Copy: docker/.env.example → docker/.env
# Do NOT use these defaults on a public host (ChangeMe / short internal key).
# Public / prod: docker/.env.public.prod.example + docs/PUBLIC-HOST.md
# Generate prod secrets: openssl rand -hex 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
# Host bind for Postgres. 5432 is the default; set 5434 if something else owns 5432.
POSTGRES_HOST_PORT=5432
JWT_SECRET=ChangeMeInProduction_UseLongRandomSecretKey123!
INTERNAL_API_KEY=element-internal-dev-key
PUBLIC_WEB_ORIGIN=http://localhost:3000
# Same origin as the SPA (canonical, OG, sitemap). Rebuild web-app after changing.
VITE_PUBLIC_SITE_URL=http://localhost:3000
# Browser calls this gateway. Local: absolute. Public single-host: /api/v1 (see .env.public.example).
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Catalog HATEOAS / swagger links (gateway public origin, no /api/v1 suffix)
PUBLIC_API_BASE=http://localhost:5000
# Empty = ClientIp trusts RFC1918+loopback (fine for localhost). Public compose sets Docker CIDRs.
TRUSTED_PROXY_CIDRS=
# Catalog house spread (0.008 = 0.8%). Bid/ask derived from last.
# Market__SpreadPct=0.008
RABBITMQ_DEFAULT_USER=element
RABBITMQ_DEFAULT_PASS=element_dev_rabbit_secret

# Optional account e-mail; blank host/from keeps recovery explicitly disabled (e-postasız beta).
# Resend later: SMTP_HOST=smtp.resend.com SMTP_USER=resend SMTP_PASSWORD=<api-key> SMTP_FROM=…
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true

# Cloudflare Turnstile — leave blank locally (captcha off). Public: see .env.public.prod.example
# CAPTCHA_SECRET_KEY=
# VITE_CAPTCHA_SITE_KEY=
