# Kök docker compose için: copy docker/.env.example docker/.env

POSTGRES_USER=postgres
POSTGRES_PASSWORD=mysecretpassword
# Host bind for Postgres. 5432 is the default; set 5434 if something else owns 5432.
POSTGRES_HOST_PORT=5432
JWT_SECRET=ChangeMeInProduction_UseLongRandomSecretKey123!
INTERNAL_API_KEY=element-internal-dev-key
PUBLIC_WEB_ORIGIN=http://localhost:3000
# Same origin as the SPA (canonical, OG, sitemap). Rebuild web-app after changing.
VITE_PUBLIC_SITE_URL=http://localhost:3000
# Browser calls this gateway. Split host example: https://api.example.com/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Catalog HATEOAS / swagger links (gateway public origin, no /api/v1 suffix)
PUBLIC_API_BASE=http://localhost:5000
# Catalog house spread (0.008 = 0.8%). Bid/ask derived from last.
# Market__SpreadPct=0.008
RABBITMQ_DEFAULT_USER=element
RABBITMQ_DEFAULT_PASS=element_dev_rabbit_secret

# Observability
SEQ_URL=http://seq:80
OTLP_ENDPOINT=http://jaeger:4317
OTLP_HTTP_ENDPOINT=http://jaeger:4318/v1/traces
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ELK / Logstash
LOGSTASH_HTTP_URL=http://logstash:8080
LOGSTASH_TCP_HOST=logstash
LOGSTASH_TCP_PORT=50000
