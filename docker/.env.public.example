# Public host for https://elements-api.ahmetfuzunkaya.com
# Copy to docker/.env on the server. Do not commit real secrets.
#
# Production rejects JWT_SECRET containing "ChangeMe" and INTERNAL_API_KEY
# shorter than 32 characters (or equal to element-internal-dev-key).
# Both values must be ≥32 characters. VITE_* is baked into the web image — rebuild after changing.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-at-least-32-characters-db-pass
POSTGRES_HOST_PORT=5432

JWT_SECRET=replace-with-at-least-32-characters-secret-key
INTERNAL_API_KEY=replace-with-at-least-32-characters-key!!

PUBLIC_WEB_ORIGIN=https://elements-api.ahmetfuzunkaya.com
VITE_PUBLIC_SITE_URL=https://elements-api.ahmetfuzunkaya.com
# Same-origin relative paths — Caddy routes /api* and /hub* to the gateway.
# Absolute https://elements-api.ahmetfuzunkaya.com/api/v1 also works if you prefer.
VITE_API_BASE_URL=/api/v1
PUBLIC_API_BASE=https://elements-api.ahmetfuzunkaya.com

RABBITMQ_DEFAULT_USER=element
RABBITMQ_DEFAULT_PASS=replace-with-at-least-32-characters-rabbit

# Optional account e-mail; blank host/from keeps recovery explicitly disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENABLE_SSL=true
