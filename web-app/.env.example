# Gateway base URL (build-time for Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Canonical / Open Graph origin (build-time). Empty → browser window.location.origin
VITE_PUBLIC_SITE_URL=http://localhost:3000

# Independent atlas: VITE_SCIENCE_API_BASE_URL=http://127.0.0.1:5080/api/v2
# Hide account and commerce actions when only the scientific service runs.
VITE_ACCOUNTS_ENABLED=true
