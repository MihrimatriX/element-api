# In-compose Caddy. Site address comes from env (CADDY_SITE).
# Local:  http://:80  (host maps CADDY_HTTP_PORT → 80)
# Server: elements-api.ahmetfuzunkaya.com  (Let's Encrypt on :80/:443)
#
# Abuse edge (no custom xcaddy image):
#   - Security headers below (CSP for SPA + Turnstile; tighten further if
#     you add more third-party scripts).
#   - request_body max 1MB
#   - Rate limits live in gateway RateLimitPolicy (register 5/min,
#     other auth POST 15/min, else 60/10s). Stock caddy:2.9-alpine has
#     no rate_limit plugin.
# When DNS is live: optional Cloudflare orange-cloud proxy = real WAF
# (see docs/PUBLIC-HOST.md). Captcha: Turnstile via CAPTCHA_* / VITE_*.
#
# Optional ACME contact: uncomment and set email inside a global block.
#
# {
# 	email you@example.com
# }

{$CADDY_SITE} {
	encode gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# Production CSP: self + Vite hashed assets + Google Fonts + Turnstile.
		# script-src keeps 'unsafe-inline' for the SPA bootstrap; drop when nonces land.
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:"
		-Server
	}

	# Cap JSON bodies (auth/orders); stock directive, no extra module.
	request_body {
		max_size 1MB
	}

	handle /api* {
		reverse_proxy gateway-service:8080
	}

	handle /hub* {
		reverse_proxy gateway-service:8080
	}

	handle /swagger* {
		reverse_proxy gateway-service:8080
	}

	handle {
		reverse_proxy web-app:80
	}
}
